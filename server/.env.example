# Telegram bot token from @BotFather
BOT_TOKEN=
# Public HTTPS address of the Mini App, e.g. https://yourname.web.app
WEBAPP_URL=
# Random secret, 32+ characters recommended
WEBHOOK_SECRET=
# Used only by set-webhook.js, e.g. https://your-game.onrender.com
PUBLIC_SERVER_URL=
# Optional server settings
PORT=8080
MAX_ROOM_PLAYERS=12
